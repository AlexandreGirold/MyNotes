{
  "name": "mynotes-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "pnpm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "build:tools": "node scripts/prepare-tools.mjs",
    "electron:make": "electron-forge make",
    "package": "pnpm run build && pnpm run build:backend && pnpm run build:tools && electron-forge make --platform=linux --arch=x64",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@marp-team/marp-cli": "4.5.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@puppeteer/browsers": "3.2.3",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.6.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
